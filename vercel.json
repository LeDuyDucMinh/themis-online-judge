{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/judge0/(.*)",
      "destination": "/api/judge0?endpoint=$1"
    },
    {
      "source": "/api/judge0",
      "destination": "/api/judge0"
    },
    {
      "source": "/api/grade",
      "destination": "/api/grade"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
