{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/grade.js": { "maxDuration": 60 },
    "api/judge0.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/judge0/(.*)",
      "destination": "/api/judge0?endpoint=$1"
    },
    {
      "source": "/api/judge0",
      "destination": "/api/judge0"
    },
    {
      "source": "/api/grade",
      "destination": "/api/grade"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
